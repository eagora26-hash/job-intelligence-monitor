# =============================================================================
# Multi-Source AI Job Intelligence Monitor — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---- Telegram notifications ----
# Create a bot with @BotFather to obtain the token; get your chat id from @userinfobot.
# Leave blank to run the monitor with notifications disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ENABLED=true
# Only notify for jobs whose relevance score is >= this threshold.
NOTIFY_MIN_SCORE=10
# Restrict per-job alerts to these sources (comma-separated). Empty = all sources.
# Recommended: the stable job boards, so marketplace gig rotation never spams the chat.
NOTIFY_SOURCES=remoteok,weworkremotely,freelancer

# ---- Scheduling ----
# Seconds between scrape cycles when running in loop/scheduler mode.
POLLING_INTERVAL=3600

# ---- Source toggles ----
ENABLE_REMOTEOK=true
ENABLE_WWR=true
ENABLE_FREELANCER=true
ENABLE_FIVERR=true
ENABLE_WELLFOUND=true

# ---- Acquisition tuning ----
# Max scrapers run concurrently.
MAX_WORKERS=5
# Per-request timeout (seconds) and retry attempts.
REQUEST_TIMEOUT=30
REQUEST_RETRIES=3
# curl_cffi browser impersonation profile used by the Scrapling Fetcher.
HTTP_IMPERSONATE=chrome
# Optional: prefer Scrapling's StealthyFetcher (Playwright) where a source is JS/anti-bot heavy.
# Requires the browser stack to be installed; off by default so the app runs without browsers.
USE_STEALTH_FALLBACK=false

# ---- Storage & paths (relative to project root) ----
DATABASE_PATH=database/jobs.db
ARCHIVE_DB_PATH=database/archive.db
DATA_DIR=data
LOG_DIR=logs
BACKUP_DIR=backup
EXPORT_DIR=exports

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Filtering (optional overrides; comma-separated). Defaults live in config/keywords.py ----
# INCLUDE_KEYWORDS=python,automation,scraping
# EXCLUDE_KEYWORDS=senior manager,clearance required
